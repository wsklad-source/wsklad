#: src/Admin/Accounts/Delete.php:95
msgid ""
"The request to disconnect the account could not be verified. Open th"
"e accounts list and try again."
msgstr "Не удалось проверить запрос на отключение аккаунта. Откройте список учётных записей и попробуйте снова."

#: src/Admin/Accounts/Delete.php:105
msgid ""
"Error. This account is active, so it cannot be deleted. Disconnect i"
"t first."
msgstr "Ошибка. Этот аккаунт активен, поэтому его нельзя удалить. Сначала отключите его."

#: src/Admin/Accounts/Delete.php:159
msgid "The account has been moved to the trash."
msgstr "Аккаунт перемещён в корзину."

#: src/Admin/Accounts/Delete.php:167
