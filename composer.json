{
    "name": "wsklad/wsklad",
    "description": "Implementation of a mechanism for flexible exchange of various data between Moy Sklad and a site running WordPress.",
    "type": "project",
    "minimum-stability": "stable",
    "license": "GPL-3.0-or-later",
    "homepage": "https://wsklad.ru",
    "autoload": {
        "psr-4": {
            "Wsklad\\": "src/"
        }
    },
    "authors": [
        {
            "name": "WSKLAD team",
            "email": "support@wsklad.ru",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "support@wsklad.ru"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://wsklad.ru/market/code"
        }
    ],
    "require": {
        "php": ">=7.4",
        "digiom/woplucore": "dev-main",
        "digiom/wotices": "1.*",
        "digiom/api-moysklad": "dev-main",
        "digiom/psr7wp": "dev-main",
        "psr/log": "1.*",
        "psr/http-message": "1.0.*",
        "monolog/monolog": "1.*"
    },
    "require-dev": {
        "php-parallel-lint/php-parallel-lint": "^1.3",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "squizlabs/php_codesniffer": "^3.7",
        "wp-coding-standards/wpcs": "^3.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "7.4.0"
        }
    },
    "scripts": {
        "audit:all": [
            "@audit:assets",
            "@audit:copy",
            "@audit:claims",
            "@audit:dangling",
            "@audit:wporg",
            "@audit:xref"
        ],
        "audit:assets": [
            "@php tools/assets.php"
        ],
        "audit:claims": [
            "@php tools/claims.php"
        ],
        "audit:copy": [
            "@php tools/verify-copy.php"
        ],
        "audit:dangling": [
            "@php tools/dangling.php"
        ],
        "audit:wporg": [
            "@php tools/wporg.php"
        ],
        "audit:xref": [
            "@php tools/xref.php"
        ],
        "i18n:pot": [
            "php tools/make-pot.php"
        ],
        "i18n:pot:check": [
            "php tools/make-pot.php --check"
        ],
        "lint:all": [
            "@lint:php",
            "@lint:cs"
        ],
        "lint:cs": "phpcs --standard=phpcs.xml.dist",
        "lint:php": "parallel-lint --exclude vendor --exclude node_modules .",
        "schema:doctor": [
            "@php tools/schema-doctor.php"
        ]
    }
}
