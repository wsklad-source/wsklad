# EditorConfig — https://editorconfig.org
#
# Tabs, not spaces, and that is the WordPress coding standard: the whole of
# `src/` and `views/` is indented with hard tabs, because WPCS enforces it and
# because a mixed codebase produces a diff on every line of a file when two
# people configure their editors differently.
#
# PHP files are the exception to "trim trailing whitespace" only in appearance:
# `trim_trailing_whitespace` does not apply to `*.php` here, because WordPress
# requires the closing `?>` of a PHP file to be followed by a newline, and an
# editor that "fixes" the last blank line changes the byte count of every PHP
# file in the repository.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4
max_line_length = 120

[*.{php,inc}]
indent_style = tab
indent_size = 4
trim_trailing_whitespace = false

[*.{js,css,scss,json,yml,yaml,neon}]
indent_style = tab
indent_size = 4

# Data files where a tab is wrong: JSON and the two config formats that
# generators rewrite. A tab here is a diff on every line when a tool
# re-serialises the file.
[*.{json,neon,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
# Two trailing spaces are a hard line break in Markdown, not stray whitespace.
trim_trailing_whitespace = false

[{composer.json,composer.lock,package.json}]
indent_style = space
indent_size = 4

[*.{po,pot,mo}]
insert_final_newline = unset
# gettext catalogues are generated; an editor must not reformat them.
trim_trailing_whitespace = unset
indent_style = unset
