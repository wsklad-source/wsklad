<?xml version="1.0"?>
<ruleset name="WSKLAD Advisory">
    <description>
        The full WordPress coding standard, run for information and never enforced.

        ⚠ Why this file exists at all, in these words, because the decision is
        counter-intuitive and the next person will otherwise "fix" it:

        `WordPress-Core` and `WordPress-Docs` want K&amp;R braces, `elseif` on the
        same line, `snake_case` methods, and a space after `(`. This codebase uses
        Allman braces, `if(`, and camelCase — everywhere, consistently, since 0.1.0 —
        and the 13 shipping extensions were written against that shape.

        Making that a blocking gate means ~34 000 findings, essentially none of which
        is a defect, and reformatting the whole plugin to satisfy it would be a
        change with a real chance of introducing one. So it is not a gate.

        What this run does instead: report the number, every time, in CI, so the
        trend is visible and a genuine regression stands out against the noise.

        `composer lint:cs` runs the blocking set. `composer lint:cs:advisory` runs
        this one and always exits 0.
    </description>

    <file>.</file>

    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/.git/*</exclude-pattern>
    <exclude-pattern>/.idea/*</exclude-pattern>
    <exclude-pattern>/plans/*</exclude-pattern>
    <exclude-pattern>/.wordpress-org/*</exclude-pattern>
    <exclude-pattern>/.phpunit.cache/*</exclude-pattern>
    <exclude-pattern>/phpcs.xml</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <arg name="basepath" value="."/>
    <arg value="s"/>
    <!-- Summary, because 34 000 lines of per-sniff output is itself a reason not to look. -->
    <arg name="report" value="summary"/>
    <arg name="parallel" value="8"/>

    <rule ref="WordPress"/>
    <rule ref="WordPress-Docs"/>
    <rule ref="WordPress-Extra"/>
    <rule ref="PHPCompatibilityWP"/>

    <config name="testVersion" value="7.4-"/>
    <config name="minimum_wp_version" value="6.0"/>
    <config name="text_domain" value="wsklad"/>
</ruleset>
